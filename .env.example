# tak-bridge settings. Copy to .env and fill in.
# Easiest: CrowdCAD's Profile > Admin > TAK > "Add TAK server" builds this
# whole file for you, including the CrowdCAD section it shows only once.

# --- TAK Server ---
# The TAK Server's address: the one ATAK/iTAK connect to, not the TAK Portal
# web address. Usually the same machine serves 8089 (streaming) and 8446
# (certificate enrollment).
TAK_HOST=
# TLS CoT streaming port.
TAK_STREAM_PORT=8089

# The bridge's TAK user (create it in TAK Portal and add it to your responders'
# groups). The bridge uses these to enroll for its own client certificate on
# port 8446, like a phone scanning an Enroll QR, then saves the certificate in
# BRIDGE_DATA_DIR and renews it before it expires. Use the user's password
# rather than a one-time token, so renewal keeps working.
TAK_USERNAME=
TAK_PASSWORD=
# Or paste TAK Portal's Enroll QR link instead of the three settings above:
# TAK_ENROLL_URL=tak://com.atakmap.app/enroll?host=...&username=...&token=...
# Only if enrollment is on a different host or port:
# TAK_ENROLL_HOST=
# TAK_ENROLL_PORT=8446

# Where the enrolled certificate and key are kept. The Docker image sets /data
# (a named volume); when run with Node directly it defaults to ./data.
# BRIDGE_DATA_DIR=./data

# Alternative to enrollment: a client certificate bundle you already have.
# TAK_CLIENT_P12=/certs/client.p12
# TAK_CLIENT_P12_PASSWORD=

# Optional: the TAK Server CA as a PEM file. Not needed with enrollment or with
# a .p12 that bundles the CA (both pin the TAK CA automatically).
# TAK_CA=
# Optional: the name the TAK Server's certificate is issued to (often
# "takserver"). When set, the bridge also checks the server certificate's name;
# when unset, it checks only that the certificate chains to the TAK CA.
# TAK_SERVER_NAME=

# TAK Server API port. Reserved for a later TAK-CAD integration; unused for now.
# TAK_API_PORT=8443

# --- CrowdCAD backend ---
# firebase (default), pocketbase, or none. "none" connects to TAK and only logs
# positions, writing nothing; use it to check the TAK side of a new setup.
CROWDCAD_BACKEND=firebase
# Firebase only:
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
# Firebase emulators only (local testing):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# PocketBase only:
POCKETBASE_URL=

# --- Bridge account (from CrowdCAD; not needed with CROWDCAD_BACKEND=none) ---
BRIDGE_EMAIL=
BRIDGE_PASSWORD=

# debug, info, warn or error
LOG_LEVEL=info
