# tak-bridge settings. Copy to .env and fill in.
# The CROWDCAD and BRIDGE sections come from CrowdCAD's "Create bridge connection"
# screen, which shows them once. The TAK section is yours to fill in.

# --- TAK Server ---
# Hostname of your TAK Server, as it appears in its TLS certificate.
TAK_HOST=
# TLS CoT streaming port.
TAK_STREAM_PORT=8089
# TAK Server API port. Reserved for a later TAK-CAD integration; unused for now.
TAK_API_PORT=8443
# The bridge user's certificate bundle from TAK Portal, as seen inside the container.
TAK_CLIENT_P12=/certs/client.p12
TAK_CLIENT_P12_PASSWORD=
# The TAK Server CA: a PEM file, or the truststore .p12 from the data package.
TAK_CA=/certs/ca.pem
# Only if TAK_CA is a .p12.
TAK_CA_P12_PASSWORD=
# Optional: TLS server name to verify, if it differs from TAK_HOST.
TAK_SERVER_NAME=

# --- CrowdCAD backend ---
# firebase (default) or pocketbase
CROWDCAD_BACKEND=firebase
# Firebase only:
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
# PocketBase only:
POCKETBASE_URL=

# --- Bridge account (from CrowdCAD) ---
BRIDGE_EMAIL=
BRIDGE_PASSWORD=

# debug, info, warn or error
LOG_LEVEL=info
