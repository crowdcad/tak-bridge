# tak-bridge settings. Copy to .env and fill in.
# The CROWDCAD and BRIDGE sections come from CrowdCAD's "Create bridge connection"
# screen, which shows them once. The TAK section is yours to fill in.

# --- TAK Server ---
# Hostname of your TAK Server, as it appears in its TLS certificate.
TAK_HOST=
# TLS CoT streaming port.
TAK_STREAM_PORT=8089
# TAK Server API port. Reserved for a later TAK-CAD integration; unused for now.
TAK_API_PORT=8443
# The bridge user's certificate bundle from TAK Portal, as seen inside the container.
TAK_CLIENT_P12=/certs/client.p12
TAK_CLIENT_P12_PASSWORD=
# Optional: the TAK Server CA as a PEM file. Leave empty if the client .p12
# already includes the CA (TAK Portal bundles normally do). To convert a
# truststore .p12:  openssl pkcs12 -in truststore.p12 -nokeys -out certs/ca.pem
TAK_CA=
# Optional: TLS server name to verify, if it differs from TAK_HOST.
TAK_SERVER_NAME=

# --- CrowdCAD backend ---
# firebase (default), pocketbase, or none. "none" connects to TAK and only logs
# positions, writing nothing; use it to check the TAK side of a new setup.
CROWDCAD_BACKEND=firebase
# Firebase only:
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
# PocketBase only:
POCKETBASE_URL=

# --- Bridge account (from CrowdCAD; not needed with CROWDCAD_BACKEND=none) ---
BRIDGE_EMAIL=
BRIDGE_PASSWORD=

# debug, info, warn or error
LOG_LEVEL=info
