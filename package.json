{
  "name": "@crowdcad/tak-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Bridge from a TAK Server to CrowdCAD (in development)",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowdcad/tak-bridge.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "sim": "node dist/sim/cli.js",
    "dev-certs": "node dist/testing/certs.js",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-crowdcad --config test/firebase.json \"vitest run --project emulator\"",
    "test:pocketbase": "vitest run --project pocketbase"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "firebase": "^12.19.0",
    "pocketbase": "^0.28.1"
  }
}
